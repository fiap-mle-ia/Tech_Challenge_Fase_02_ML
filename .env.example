# Copie para .env e ajuste se precisar: cp .env.example .env
# O .env real nunca vai para o Git.

# Servidor do MLflow (tracking + Model Registry).
# Local, sem servidor: sqlite:///mlflow.db  ·  Com docker compose: http://mlflow:5000
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=propensao-compra
MLFLOW_REGISTERED_MODEL_NAME=propensao-compra-classificador
MLFLOW_CHAMPION_ALIAS=champion

# Arquivo de parâmetros do pipeline (seeds, split, hiperparâmetros)
PARAMS_PATH=configs/params.yaml

# Nível de log da aplicação
LOG_LEVEL=INFO
